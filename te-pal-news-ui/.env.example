# Supabase (required for posts + auth)
# Get these from https://supabase.com/dashboard → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: UUID of an auth user to use when posting as "Admin" (Auth → Users → copy user UUID)
# Create that user in Supabase Auth and a profile with display_name "Admin", then set this.
# SUPABASE_ADMIN_UID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
